[Desktop Entry]
Name=KeePassXC
Comment=Find secrets and copy them to the clipboard or type them
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
Icon=object-unlocked
X-KDE-PluginInfo-Author=naglfar
X-KDE-PluginInfo-Email=
X-KDE-PluginInfo-Name=krunner-keepassxc
X-KDE-PluginInfo-Version=2.1.1
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=de.naglfar.krunner-keepassxc
X-Plasma-DBusRunner-Path=/krunner
X-Plasma-Runner-Syntaxes=:q:
X-Plasma-Runner-Syntax-Descriptions=Finds KeePassXC entries whose title, group, URL or user name contain :q:. Enter copies or types the password and Shift+Enter the user name.
