# ~/.config/autostart/

[Desktop Entry]
Version=2.0.0
Type=Application
Name=Runner
Comment=Autostart entry krunner-keepassxc
Keywords=Runner;Krunner
Categories=Utilities
# as nuitka built binary
#Exec=/path/to/krunner_keepassxc run
# as shiv built pyz archive
#Exec=/path/to/krunner_keepassxc.pyz run
# as global package
#Exec=python3 -m krunner_keepassxc run
# in a virtual environment
#Exec=/path/to/venv/bin/python -m krunner_keepassxc run
Icon=python
StartupNotify=true
